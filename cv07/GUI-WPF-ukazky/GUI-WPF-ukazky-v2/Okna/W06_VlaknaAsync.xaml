<Window x:Class="WpfUkazky.Okna.W06_VlaknaAsync"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vlákna – async/await (slajd 17)" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="Počet prebehnutých cyklov" />
        <TextBox x:Name="textBox1" Grid.Column="1" Margin="4" IsReadOnly="True" />
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Rows="1">
            <Button Content="Štart" Margin="4" Click="button1_Click" />
            <Button Content="Stop" Margin="4" Click="button2_Click" />
        </UniformGrid>
    </Grid>
</Window>
