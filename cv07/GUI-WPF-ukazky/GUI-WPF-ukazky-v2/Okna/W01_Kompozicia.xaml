<Window x:Class="WpfUkazky.Okna.W01_Kompozicia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kompozícia a Content (slajdy 8, 11, 12)" SizeToContent="WidthAndHeight">
    <WrapPanel Margin="10">

        <!-- slajd 7: StackPanel s dvoma prvkami -->
        <GroupBox Header="StackPanel" Margin="5" Width="200">
            <StackPanel Margin="10">
                <TextBox>Hello There</TextBox>
                <Button>Click Me!</Button>
            </StackPanel>
        </GroupBox>

        <!-- slajd 8: tlačidlo obsahuje obrázok a text -->
        <GroupBox Header="Kompozitné tlačidlo" Margin="5">
            <Button Margin="20" Padding="50 10">
                <StackPanel>
                    <Image Source="../Images/tiger2.png" Width="150" />
                    <TextBlock TextAlignment="Center">Hello there</TextBlock>
                </StackPanel>
            </Button>
        </GroupBox>

        <!-- slajd 11: element syntax a attribute syntax dávajú to isté -->
        <GroupBox Header="Content atribút" Margin="5" Width="200">
            <StackPanel Margin="10">
                <Button>
                    <Button.Content>
                        Click me! (element syntax)
                    </Button.Content>
                </Button>
                <Button Content="Click me! (attribute syntax)" Margin="0 5 0 0" />
                <Button Margin="0 5 0 0">Click me! (implicitný Content)</Button>
            </StackPanel>
        </GroupBox>

        <!-- slajd 12: implicitná kolekcia – ListBox.Items môžeme vynechať -->
        <GroupBox Header="Content – kolekcia" Margin="5" Width="200">
            <ListBox Margin="10">
                <ListBoxItem Content="aaa" />
                <ListBoxItem Content="bbb" />
            </ListBox>
        </GroupBox>

    </WrapPanel>
</Window>
