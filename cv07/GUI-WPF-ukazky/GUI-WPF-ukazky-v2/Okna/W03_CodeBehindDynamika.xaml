<Window x:Class="WpfUkazky.Okna.W03_CodeBehindDynamika"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{x:Static SystemColors.ControlBrush}" Title="MainWindow" Height="139" Width="286">
    <!-- slajd 14 – Canvas je tu zámerne: tlačidlo sa posúva cez Canvas.SetLeft -->
    <Canvas>
        <Label x:Name="lblOtazka" Canvas.Left="45" Canvas.Top="7" Content="Ideme na pivo?" FontWeight="Bold" FontSize="24" />
        <Button x:Name="btnAno" Canvas.Left="10" Canvas.Top="58" Content="Áno" Width="70" FontWeight="Bold" />
        <Button x:Name="btnNie" Canvas.Left="100" Canvas.Top="58" Content="Nie" Width="70" FontWeight="Bold" />
    </Canvas>
</Window>
