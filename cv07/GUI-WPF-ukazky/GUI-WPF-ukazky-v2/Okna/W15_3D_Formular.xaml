<Window x:Class="WpfUkazky.Okna.W15_3D_Formular"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfUkazky.Okna"
        xmlns:vm="clr-namespace:WpfUkazky.ViewModels"
        Title="3D – formulár s knihami (slajd 37)" Height="600" Width="900">

    <Window.DataContext>
        <vm:LibraryViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- uhol natočenia formulára -->
        <Slider x:Name="SliderUhol" DockPanel.Dock="Top" Width="400" Margin="5"
                Minimum="-80" Maximum="80" Value="-40"/>

        <Viewport3D ClipToBounds="True">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,4" />
            </Viewport3D.Camera>
            <Viewport2DVisual3D>
                <Viewport2DVisual3D.Transform>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D Angle="{Binding Value, ElementName=SliderUhol}" Axis="0, 1, 0" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </Viewport2DVisual3D.Transform>
                <Viewport2DVisual3D.Geometry>
                    <MeshGeometry3D Positions="-1,1,0 -1,-1,0 1,-1,0 1,1,0" TextureCoordinates="0,0 0,1 1,1 1,0" TriangleIndices="0 1 2 0 2 3"/>
                </Viewport2DVisual3D.Geometry>
                <Viewport2DVisual3D.Material>
                    <DiffuseMaterial Viewport2DVisual3D.IsVisualHostMaterial="True" Brush="White"/>
                </Viewport2DVisual3D.Material>
                <!-- ten istý formulár ako v ukážke Knihy – v 3D ostáva plne funkčný -->
                <Viewport2DVisual3D.Visual>
                    <local:KnihyView Width="600" Height="500" Background="White" />
                </Viewport2DVisual3D.Visual>
            </Viewport2DVisual3D>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="#FFFFFFFF" Direction="0,0,-1"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
    </DockPanel>
</Window>
