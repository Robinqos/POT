<Window x:Class="WpfUkazky.Okna.W16_Multimedia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multimédiá (slajd 38)" Width="1050" SizeToContent="Height">
    <!-- relatívne cesty: súbory v priečinku Media sa kopírujú vedľa .exe (Copy to Output Directory) -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <MediaElement Source="Media/MassiveSlide.wmv" Width="500" />
            <MediaElement Source="Media/ManInTheKitchen.wmv" Width="500" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <MediaElement Source="Media/SnowReport.wmv" Width="500" />
            <MediaElement Source="Media/NudzovePristatie.wmv" Width="500" />
        </StackPanel>
    </StackPanel>
</Window>
