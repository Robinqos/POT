<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WpfUkazky</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- obrázky sú súčasťou zostavenia (pack URI), videá sa kopírujú vedľa .exe -->
    <Resource Include="Images\*.png" />
    <Content Include="Media\*.wmv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
