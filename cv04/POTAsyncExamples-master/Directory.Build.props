<Project>
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AssemblyName>KST.POT.AsyncExamples.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>KST.POT.AsyncExamples.$(MSBuildProjectName)</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Common'">
		<ProjectReference Include="../Common/Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="KST.POT.AsyncExamples.Common" />
		<Using Include="KST.POT.AsyncExamples.$(MSBuildProjectName)" />
	</ItemGroup>

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>
</Project>
