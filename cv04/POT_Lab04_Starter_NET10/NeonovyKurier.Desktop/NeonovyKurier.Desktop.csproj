  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <ProjectReference Include="../NeonovyKurier.Core/NeonovyKurier.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../NeonovyKurier.Cli/MissionContent.cs" Link="Infrastructure/MissionContent.cs" />
    <Compile Include="../NeonovyKurier.Cli/Infrastructure/DemoServer.cs" Link="Infrastructure/DemoServer.cs" />
    <None Include="../NeonovyKurier.Cli/Content/**" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
